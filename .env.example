# Copy to .env (never committed). Empty keys run everything offline.
MUBIT_API_KEY=
# off: calls go through Mubit unrecorded, so this key's app trains on nothing
MUBIT_RECORD=on
# the owner's key, used (and recorded) once MUBIT_API_KEY runs out of credit (402)
MUBIT_FALLBACK_KEY=
# The commentator's voice; empty means GET /lines/{id}/audio answers 503 and the page uses browser speech.
ELEVENLABS_API_KEY=
# Optional: a sport's voice (an id from GET /voices or a raw ElevenLabs voice id) and model.
# Unset: connor (football), viraj (cricket), sam (basketball), eleven_v3. See docs/voice.md.
# scripts/deploy.sh passes each one set here or in the environment on to Cloud Run.
VOICE_FOOTBALL=
VOICE_CRICKET=
VOICE_BASKETBALL=
VOICE_MODEL_FOOTBALL=
VOICE_MODEL_CRICKET=
VOICE_MODEL_BASKETBALL=
# Optional: the name a pick shows on the page, e.g. British Football Announcer. Unset: "Football pick".
VOICE_LABEL_FOOTBALL=
VOICE_LABEL_CRICKET=
# The live site's budget guard (#244); 0 turns one off. Unset: 4, 10, 20, 5.
MAX_LIVE_REPLAYS=
REPLAYS_PER_HOUR=
ASKS_PER_HOUR=
DAILY_BUDGET_USD=
# local (JSON-lines under STORE_DIR) or cloud (needs STORE_URL=gs://bucket/prefix)
MODE=local
STORE_DIR=data
STORE_URL=
